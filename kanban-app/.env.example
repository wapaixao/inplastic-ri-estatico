# Copie este arquivo para .env e ajuste antes de produção
PORT=3000
NODE_ENV=production

# Obrigatório. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-uma-string-longa-gerada-com-openssl

# Caminho do banco SQLite
DB_PATH=./data/kanban.db

# Em HTTPS com Nginx/Certbot use true. Em teste local use false.
COOKIE_SECURE=false

# Domínio autorizado para CORS simples/mesma origem. Em geral deixe vazio.
PUBLIC_ORIGIN=

# Se for servido dentro do Portal RI, use /kanban
BASE_PATH=/kanban
